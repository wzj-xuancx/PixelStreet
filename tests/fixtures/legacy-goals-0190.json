    },
    "ready-six": {
      "name": "行路者徽记",
      "line": "idle",
      "goal": "六格装备齐备获胜",
      "detail": "出发时人物六格装备齐备，赢下一场挂机遭遇。"
    },
    "two-builds": {
      "name": "双途徽记",
      "line": "idle",
      "goal": "冰印连招与采集获胜",
      "detail": "一趟戴蓝石坠饰实际引爆冰印后获胜；另一趟戴叶纹胸针，在野外采集路线获胜。"
    },
    "moss-guardian": {
      "name": "苔光守护徽记",
      "line": "idle",
      "goal": "苔团子整装深入获胜",
      "detail": "苔团子三格装备齐备，携菌菇汤，在裂晶洞口或更深地区的增强远征中获胜。"
    }
  },
